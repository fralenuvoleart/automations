{
  "version": 8,
  "_comment": "Single source of truth: capability ID -> MCP server + tool + fixed `args` (validated against the tool inputSchema) + `runtime` (args the agent supplies) + `desc` (purpose; rendered into each skill's Data Sources table). Skills author capabilities as {{cap:<id>}}; `python3 seo/resolve.py --write` renders them as <!--cap:<id>-->...<!--/cap--> blocks and re-renders every block on each run, so registry edits propagate. GSC rules: every analytics_query pins rowLimit 25000 (API default is 1000) and engine google (tool default is all = Google+Bing).",
  "servers": {
    "search-console": { "package": "npx search-console-mcp@2.1.4", "auth": "oauth", "credentials": "OAuth managed by the server (`~/.search-console-mcp-config.enc`)" },
    "analytics": { "package": "~/.venvs/analytics-mcp (official GA4)", "auth": "service-account", "credentials": "service account via `GOOGLE_APPLICATION_CREDENTIALS`; the account must be added to the GA4 property" },
    "google-ads": { "package": "googleads/google-ads-mcp", "auth": "service-account", "credentials": "service account via `GOOGLE_APPLICATION_CREDENTIALS`; pass `login_customer_id` when access is through a manager account" },
    "google-ads-planner": { "package": "seo/mcp-servers/google-ads-planner", "auth": "service-account", "credentials": "service account via `GOOGLE_APPLICATION_CREDENTIALS`; customer ID from the site profile `ads_customer_id`" },
    "dataforseo": { "package": "npx dataforseo-mcp-server@3.1.3", "auth": "api-key", "configured": false, "third_party": "DataForSEO", "credentials": "needs `DATAFORSEO_LOGIN` / `DATAFORSEO_PASSWORD`", "note": "Optional — not in .roo/mcp.json. Skills degrade gracefully without it." },
    "tavily": { "package": "npx tavily-mcp@0.2.3", "auth": "api-key", "third_party": "Tavily", "credentials": "`TAVILY_API_KEY` in `.roo/mcp.json` → `mcpServers.tavily.env`" }
  },
  "capabilities": {
    "gsc.sites_list": { "server": "search-console", "tool": "sites_list", "args": { "engine": "google" }, "runtime": [], "aliases": [], "desc": "Verified Search Console properties" },
    "gsc.diagnostics": { "server": "search-console", "tool": "diagnostics", "args": {}, "runtime": [], "aliases": [], "desc": "Connection check (`google` must report ok)" },
    "gsc.daily_totals": { "server": "search-console", "tool": "analytics_query", "args": { "dimensions": ["date"], "rowLimit": 25000, "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Daily site totals, including anonymized queries (reconciliation baseline)" },
    "gsc.query": { "server": "search-console", "tool": "analytics_query", "args": { "dimensions": ["query"], "rowLimit": 25000, "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Query-level clicks/impressions/CTR/position (anonymized queries excluded)" },
    "gsc.page": { "server": "search-console", "tool": "analytics_query", "args": { "dimensions": ["page"], "rowLimit": 25000, "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Page-level totals, including anonymized-query clicks" },
    "gsc.page_query": { "server": "search-console", "tool": "analytics_query", "args": { "dimensions": ["query", "page"], "rowLimit": 25000, "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Query × page attribution (anonymized queries excluded)" },
    "gsc.geo_query": { "server": "search-console", "tool": "analytics_query", "args": { "dimensions": ["country", "query"], "rowLimit": 25000, "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Query by country (align organic with ad geo-targeting)" },
    "gsc.compare_period": { "server": "search-console", "tool": "analytics_compare", "args": { "mode": "period_over_period", "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate", "compareStartDate", "compareEndDate"], "aliases": [], "desc": "Aggregate period-over-period delta" },
    "gsc.compare_trends": { "server": "search-console", "tool": "analytics_compare", "args": { "mode": "trends", "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Gradual trend detection" },
    "gsc.compare_drop": { "server": "search-console", "tool": "analytics_compare", "args": { "mode": "drop_attribution", "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Drop attribution (which segments drove a decline)" },
    "gsc.anomalies": { "server": "search-console", "tool": "analytics_anomalies", "args": { "engine": "google" }, "runtime": ["siteUrl", "startDate", "endDate"], "aliases": [], "desc": "Day-level anomaly detection" },
    "gsc.health": { "server": "search-console", "tool": "site_health_check", "args": { "level": "crawl_issues", "engine": "google" }, "runtime": ["siteUrl"], "aliases": [], "desc": "Crawl/robots/sitemap blockers (report only the fields returned; not a site-wide index count)" },
    "gsc.inspect": { "server": "search-console", "tool": "inspection_inspect", "args": { "engine": "google" }, "runtime": ["siteUrl", "urls"], "aliases": [], "desc": "URL Inspection: coverage state, canonicals, last crawl (quota 2,000/day/property)" },
    "gsc.sitemaps": { "server": "search-console", "tool": "sitemaps_list", "args": { "engine": "google" }, "runtime": ["siteUrl"], "aliases": [], "desc": "Submitted sitemaps, last read, errors/warnings (the API no longer reports indexed counts)" },
    "gsc.indexing": { "server": "search-console", "tool": "indexing_submit", "args": { "method": "standard", "engine": "google" }, "runtime": ["siteUrl", "urls"], "aliases": [], "desc": "Indexing API submission — only after explicit user confirmation" },
    "gsc.keywords_related": { "server": "search-console", "tool": "seo_keywords_research", "args": { "type": "related", "engine": "google" }, "runtime": ["keywords", "language", "country"], "aliases": [], "desc": "Related keyword expansion (volumes are estimates)" },
    "gsc.keywords_stats": { "server": "search-console", "tool": "seo_keywords_research", "args": { "type": "stats", "engine": "google" }, "runtime": ["keywords", "language", "country"], "aliases": [], "desc": "Keyword volume estimates (planner fallback; label as estimates)" },
    "gsc.genai": { "server": "search-console", "tool": "genai_query_insights", "args": { "engine": "google", "includePages": true }, "runtime": ["siteUrl", "days"], "aliases": [], "desc": "AI-prompt-shaped GSC queries (heuristic; `days` = window length)" },
    "gsc.pagespeed": { "server": "search-console", "tool": "pagespeed_analyze", "args": {}, "runtime": ["url", "strategy"], "aliases": [], "desc": "PageSpeed: CrUX field data (when available) + Lighthouse lab data" },
    "gsc.pagespeed_a11y": { "server": "search-console", "tool": "pagespeed_analyze", "args": { "category": ["accessibility"] }, "runtime": ["url", "strategy"], "aliases": [], "desc": "Lighthouse accessibility category" },
    "gsc.schema": { "server": "search-console", "tool": "schema_validate", "args": {}, "runtime": ["url"], "aliases": [], "desc": "Structured-data validation" },
    "gsc.compare_engines": { "server": "search-console", "tool": "compare_engines", "args": {}, "runtime": ["siteUrl", "dimension", "startDate", "endDate"], "aliases": [], "desc": "Google vs Bing divergence (only when Bing is connected)" },
    "gsc.analytics_advanced": { "server": "search-console", "tool": "analytics_advanced", "args": {}, "runtime": ["propertyId", "metricType", "startDate", "endDate"], "aliases": [], "desc": "Aggregate GA4 metrics via search-console (no source breakdown)" },

    "ga4.properties": { "server": "analytics", "tool": "get_account_summaries", "args": {}, "runtime": [], "aliases": [], "desc": "GA4 accounts/properties (connection check)" },
    "ga4.ai_sources": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["sessionSource", "sessionMedium"], "metrics": ["sessions", "keyEvents", "engagementRate"] }, "runtime": ["property_id", "date_ranges", "dimension_filter"], "aliases": ["analytics_traffic_sources"], "desc": "AI-assistant referral sessions (filter from `site_profile.py --ga4-ai-filter`)" },
    "ga4.ai_time_series": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["date", "sessionSource"], "metrics": ["sessions"] }, "runtime": ["property_id", "date_ranges", "dimension_filter"], "aliases": [], "desc": "Daily AI-assistant referral sessions (same AI filter)" },
    "ga4.ai_cited_pages": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["sessionSource", "landingPagePlusQueryString"], "metrics": ["sessions", "keyEvents"] }, "runtime": ["property_id", "date_ranges", "dimension_filter"], "aliases": [], "desc": "Landing pages AI assistants send visitors to (same AI filter)" },
    "ga4.channels": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["sessionDefaultChannelGroup", "sessionSource", "sessionMedium"], "metrics": ["sessions", "keyEvents", "engagementRate"] }, "runtime": ["property_id", "date_ranges"], "aliases": [], "desc": "Sessions/key events by channel and source (organic baseline)" },
    "ga4.organic_landing_pages": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["landingPagePlusQueryString"], "metrics": ["sessions", "engagementRate", "keyEvents"], "dimension_filter": { "filter": { "field_name": "sessionDefaultChannelGroup", "string_filter": { "match_type": "EXACT", "value": "Organic Search", "case_sensitive": false } } } }, "runtime": ["property_id", "date_ranges"], "aliases": ["analytics_organic_landing_pages"], "desc": "Organic-search landing pages: sessions, engagement, key events" },
    "ga4.landing_source": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["landingPage", "sessionSourceMedium"], "metrics": ["sessions", "engagedSessions", "keyEvents"], "limit": 25000 }, "runtime": ["property_id", "date_ranges"], "aliases": [], "desc": "Sessions, engaged sessions and key events by landing page × source/medium (classified with the site rules: channel, page type, language)" },
    "ga4.referrals": { "server": "analytics", "tool": "run_report", "args": { "dimensions": ["sessionSource"], "metrics": ["sessions", "keyEvents"], "dimension_filter": { "filter": { "field_name": "sessionMedium", "string_filter": { "match_type": "EXACT", "value": "referral", "case_sensitive": false } } } }, "runtime": ["property_id", "date_ranges"], "aliases": [], "desc": "Referral sessions by source domain" },

    "ads.customers": { "server": "google-ads", "tool": "customers_list_accessible_customers", "args": {}, "runtime": [], "aliases": ["list_accessible_customers"], "desc": "Accessible Ads customer IDs" },
    "ads.metadata": { "server": "google-ads", "tool": "metadata_get_resource_metadata", "args": {}, "runtime": ["resource_name", "login_customer_id"], "aliases": [], "desc": "GAQL field discovery (verify fields before querying)" },
    "ads.search": { "server": "google-ads", "tool": "search_search", "args": {}, "runtime": ["customer_id", "resource", "fields", "conditions", "orderings", "login_customer_id"], "aliases": [], "desc": "GAQL query (search terms, account currency)" },

    "planner.ideas": { "server": "google-ads-planner", "tool": "generate_keyword_ideas", "args": {}, "runtime": ["customer_id", "keywords", "language", "geo_targets"], "aliases": [], "policy": { "retry": 0, "timeout_budget_s": 40, "on_error": "degrade" }, "desc": "Keyword Planner ideas: volume, competition, bids (≤20 seeds per call; server retries internally)" },
    "planner.historical": { "server": "google-ads-planner", "tool": "keyword_historical_metrics", "args": {}, "runtime": ["customer_id", "keywords", "language", "geo_targets"], "aliases": [], "policy": { "retry": 0, "timeout_budget_s": 40, "on_error": "degrade" }, "desc": "Keyword Planner metrics for an exact keyword list (≤1,000 per call)" },

    "dfs.backlinks_summary": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/backlinks/summary/live" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "Backlink profile summary (index estimate)" },
    "dfs.referring_domains": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/backlinks/referring_domains/live" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "Referring domains (index estimate)" },
    "dfs.anchors": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/backlinks/anchors/live" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "Anchor-text distribution (index estimate)" },
    "dfs.backlinks_new_lost": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/backlinks/timeseries_new_lost_summary/live" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "New/lost backlinks and referring domains over time (link velocity)" },
    "dfs.ranked_keywords": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/dataforseo_labs/google/ranked_keywords/live" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "Keywords a domain ranks for (estimate)" },
    "dfs.serp": { "server": "dataforseo", "tool": "api_request", "args": { "method": "POST", "path": "/v3/serp/google/organic/live/advanced" }, "runtime": ["data"], "aliases": [], "policy": { "on_error": "degrade" }, "desc": "Live Google SERP incl. SERP features (featured snippet, PAA, AI Overview)" },

    "web.search": { "server": "tavily", "tool": "tavily-search", "args": { "search_depth": "basic", "max_results": 10 }, "runtime": ["query"], "aliases": [], "desc": "Web search fallback — not Google's ranking order; label as approximate" },
    "web.extract": { "server": "tavily", "tool": "tavily-extract", "args": { "extract_depth": "basic" }, "runtime": ["urls"], "aliases": [], "desc": "Extract page content when `site_crawl.py facts` cannot fetch a page (JS-rendered/blocked)" }
  }
}
