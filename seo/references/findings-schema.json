{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SEO Findings (loose)",
  "description": "The LLM writes this; seo/report/build_report.py renders it. Values are free text; only the shape is enforced.",
  "type": "object",
  "required": ["skill", "as_of", "window", "verdict", "sections"],
  "properties": {
    "skill": { "type": "string" },
    "as_of": { "type": "string", "description": "YYYY-MM-DD anchor" },
    "window": {
      "type": "object",
      "required": ["startDate", "endDate"],
      "properties": {
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "compareStartDate": { "type": "string" },
        "compareEndDate": { "type": "string" },
        "lag": { "type": "integer" }
      }
    },
    "verdict": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "table": { "type": "array", "items": { "type": "object" } },
          "estimate": { "type": "boolean", "description": "true => body must carry an estimate/heuristic label" }
        }
      }
    },
    "actions": { "type": "array", "items": { "type": "string" } },
    "unavailable": {
      "type": "array",
      "description": "Sources that were expected but not available (graceful degradation). Rendered as a 'Data availability' section.",
      "items": {
        "type": "object",
        "required": ["source", "affects"],
        "properties": {
          "source": { "type": "string" },
          "affects": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Coverage of the site profile's priority keywords/pages. Rendered as a 'Coverage vs site profile' section. Produce it deterministically with seo/coverage.py.",
      "properties": {
        "priority_keywords": { "type": "array", "items": { "type": "string" } },
        "priority_pages": { "type": "array", "items": { "type": "string" } },
        "covered": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } },
        "by_language": {
          "type": "object",
          "description": "Per-language coverage counts (language code -> {total, covered, missing}).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "covered": { "type": "integer" },
              "missing": { "type": "integer" }
            }
          }
        },
        "pages_covered": { "type": "array", "items": { "type": "string" } },
        "pages_missing": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
