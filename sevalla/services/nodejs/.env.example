# BOT_TOKEN=your_bot_token_from_botfather  (set it only on Sevalla, never commit a real token)
# ADMIN_CHAT_ID=-1003837689636

# Custom messages (optional — defaults are English)
# {name} is replaced with user's first name in autoreply
# MSG_WELCOME=Welcome to PBS Services! 👋
# MSG_WELCOME_RU=Добро пожаловать в PBS Services! 👋
# MSG_AUTOREPLY=Hi {name}, your message has been forwarded to our team.
# MSG_AUTOREPLY_RU=Здравствуйте, {name}, ваше сообщение было передано нашей команде.

# Delay before auto-reply (milliseconds, default: 10000 = 10 seconds)
# AUTOREPLY_DELAY_MS=10000

# Integrately webhook (optional — uncomment to override)
# INTEGRATELY_WEBHOOK_URL=https://webhooks.integrately.com/a/webhooks/11e1f7e4cb3e4517abcea0d9cd833383

# Cache warmer configuration (defaults shown — uncomment to override)
# WARMER_SITEMAP_URL=https://pbservices.ge/sitemap-index.xml
# WARMER_REQUEST_DELAY_MS=2000
# WARMER_DISCOVERY_CONCURRENCY=3
# WARMER_RETRY_COUNT=2
# WARMER_USER_AGENT=SevallaCacheWarmer/1.0 (+https://pbservices.ge; token:cache-warmer)
# WARMER_PROGRESS_INTERVAL=10

# Secret token for public warmer trigger endpoint
# WARMER_TOKEN=your-secret-token-here

# Telegram Business lead capture (src/business-bot.js)
# INTEGRATELY_BUSINESS_WEBHOOK_URL=https://webhooks.integrately.com/a/webhooks/your_webhook_id
# BUSINESS_WINDOW_MS=30000
# LEAD_COOLDOWN_HOURS=24
# BUSINESS_TEST_CHAT_IDS=  (optional, comma separated Telegram user IDs for testing)
