  "tavily": {
    "tavily-crawl": {
      "properties": {
        "allow_external": {
          "default": false,
          "description": "Whether to allow following links that go to external domains",
          "type": "boolean"
        },
        "categories": {
          "default": [],
          "description": "Filter URLs using predefined categories like documentation, blog, api, etc",
          "items": {
            "enum": [
              "Careers",
              "Blog",
              "Documentation",
              "About",
              "Pricing",
              "Community",
              "Developers",
              "Contact",
              "Media"
            ],
            "type": "string"
          },
          "type": "array"
